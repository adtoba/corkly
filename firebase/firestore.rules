rules_version = '2';

// Corkly shared boards.
// Roles: owner (everything), edit (change anything on the board), pin (add things; change only their own).
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function memberPath(b) { return /databases/$(db)/documents/boards/$(b)/members/$(request.auth.uid); }
    function isMember(b) { return signedIn() && exists(memberPath(b)); }
    function roleOf(b) { return get(memberPath(b)).data.role; }
    function isOwner(b) { return isMember(b) && roleOf(b) == 'owner'; }
    function canEditAll(b) { return isMember(b) && roleOf(b) in ['owner', 'edit']; }

    function validInvite(b, code, role) {
      let inv = get(/databases/$(db)/documents/invites/$(code)).data;
      return inv.boardId == b && inv.active == true && inv.role == role && request.time < inv.expiresAt;
    }

    match /boards/{b} {
      allow read: if isMember(b);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if canEditAll(b) && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isOwner(b);

      match /members/{uid} {
        allow read: if isMember(b);
        allow create: if signedIn() && uid == request.auth.uid && (
          // the owner adding themselves right after creating the board
          (request.resource.data.role == 'owner'
            && get(/databases/$(db)/documents/boards/$(b)).data.ownerId == request.auth.uid)
          // anyone joining with a valid invite code, at exactly the invite's role
          || (request.resource.data.role in ['edit', 'pin']
            && request.resource.data.invite is string
            && validInvite(b, request.resource.data.invite, request.resource.data.role))
        );
        // owner can change roles; people can update their own name but not their role
        allow update: if isOwner(b)
          || (uid == request.auth.uid && request.resource.data.role == resource.data.role);
        // owner can remove people; people can leave (the owner can't leave their own board)
        allow delete: if isOwner(b) || (uid == request.auth.uid && resource.data.role != 'owner');
      }

      match /items/{id} {
        allow read: if isMember(b);
        allow create: if isMember(b) && request.resource.data.authorId == request.auth.uid;
        allow update: if isMember(b)
          && request.resource.data.authorId == resource.data.authorId
          && (canEditAll(b) || resource.data.authorId == request.auth.uid);
        allow delete: if canEditAll(b) || (isMember(b) && resource.data.authorId == request.auth.uid);
      }

      // photos, stored as compressed bytes (Corkly shrinks them to well under 1 MB)
      match /images/{id} {
        allow read: if isMember(b);
        allow create: if isMember(b)
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.data is bytes
          && request.resource.data.data.size() < 1000000;
        allow update: if false;
        allow delete: if canEditAll(b) || (isMember(b) && resource.data.authorId == request.auth.uid);
      }

      match /strings/{id} {
        allow read: if isMember(b);
        allow create: if isMember(b) && request.resource.data.authorId == request.auth.uid;
        allow update: if isMember(b)
          && request.resource.data.authorId == resource.data.authorId
          && (canEditAll(b) || resource.data.authorId == request.auth.uid);
        allow delete: if canEditAll(b) || (isMember(b) && resource.data.authorId == request.auth.uid);
      }
    }

    match /invites/{code} {
      // anyone signed in who knows the code can look it up, but nobody can browse codes
      allow get: if signedIn();
      allow list: if isOwner(resource.data.boardId);
      allow create: if isOwner(request.resource.data.boardId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.role in ['edit', 'pin'];
      allow update, delete: if isOwner(resource.data.boardId);
    }

    // each person's list of boards shared with them
    match /users/{uid}/boards/{b} {
      allow read, write: if signedIn() && uid == request.auth.uid;
    }
  }
}
